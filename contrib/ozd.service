#
# ozd as a systemd service (docs/design.md §10). Install the binary at
# /usr/local/bin/ozd and its flags in /etc/ozdrc; make a user
# ozd that owns the writable root and nothing else, and list that root
# in ReadWritePaths. Not yet tried on a system.

[Unit]
Description=ozd, the associated machine for a site of CADR Lisp Machines
After=network-online.target
Wants=network-online.target

[Service]
User=ozd
ExecStart=/usr/local/bin/ozd -c /etc/ozdrc
Restart=on-failure

# Hardening that costs nothing here: ozd needs no privilege and
# writes nothing but its writable roots.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/lispm
ProtectHome=yes
PrivateTmp=yes
# A root under /home needs ProtectHome=read-only instead, or none.

[Install]
WantedBy=multi-user.target
